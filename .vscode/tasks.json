{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: Clean Rebuild All Puretone U5A5 Variants (12 bins)",
            "type": "shell",
            "command": "${workspaceFolder}/.pixi/bin/pixi.exe run clean-build-puretone-variants",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": "build"
        },
        {
            "label": "CMake: Clean Rebuild All Puretone U535 Variants (12 bins)",
            "type": "shell",
            "command": "${workspaceFolder}/.pixi/bin/pixi.exe run clean-build-puretone-u535-variants",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": "build"
        },
        {
            "label": "[DFU/STM32] Flash binary",
            "type": "shell",
            "command": "${workspaceFolder}/.pixi/bin/pixi.exe run flash ${command:cmake.selectLaunchTarget}",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
